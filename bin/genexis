BASE_DIR="$(cd "$(dirname "$0")" && pwd)"
#!/bin/bash
set -euo pipefail  # Strict mode: exit on error, undefined vars, pipe failures

echo "======================================"
echo "        GENEXIS TOOLKIT v2.0"
echo "======================================"

MODULE=""
INPUT=""
DOMAIN=""
PATTERN=""

# -------------------------------
# Argument Parsing (ENHANCED)
# -------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --module)
      MODULE="$2"
      shift 2
      ;;
    --input|-i)
      INPUT="$2"
      shift 2
      ;;
    --domain|-d)
      DOMAIN="$2"
      shift 2
      ;;
    --pattern|-p)
      PATTERN="$2"
      shift 2
      ;;
        --help|-h)
      cat << EOF

======================================
         GENEXIS TOOLKIT v2.0
======================================

DESCRIPTION:
  Modular bioinformatics toolkit for sequence analysis,
  motif detection, translation, mutation analysis,
  ORF prediction, and genome assembly utilities.

USAGE:
  $0 --module <module_name> --input <file.fasta> [options]

BASIC EXAMPLES:
  # Sequence statistics
  $0 --module seq-analysis --input sample.fasta

  # Motif search
  $0 --module motif --input sample.fasta --pattern ATG

  # DNA to protein translation
  $0 --module translation --input sample.fasta

  # ORF prediction
  $0 --module orf --input sample.fasta

  # Mutation analysis
  $0 --module mutation --input sample.fasta

  # Genome assembly
  $0 --module assembly --input reads.fastq

  # Domain-specific analysis
  $0 --module analysis --input sample.fasta --domain cancer

AVAILABLE MODULES:
  seq-analysis   Perform sequence statistics and GC analysis
  motif          Search for DNA/RNA motifs or patterns
  translation    Translate DNA sequences into proteins
  orf            Identify Open Reading Frames (ORFs)
  mutation       Detect and analyze sequence mutations
  assembly       Perform basic sequence assembly operations
  analysis       Domain-specific biological analysis

OPTIONS:
  -i, --input <file>
        Input FASTA/FASTQ file

  -p, --pattern <motif>
        DNA/RNA motif pattern for motif search

  -d, --domain <name>
        Analysis domain (example: cancer)

  -h, --help
        Display this help message

FEATURES:
  ✔ Strict error handling
  ✔ Modular architecture
  ✔ Large file support
  ✔ Memory-efficient execution
  ✔ Easy pipeline integration

AUTHOR:
  Genexis Bioinformatics Toolkit

EOF
      exit 0
      ;;
    *)
      echo "Error: Unknown option: $1" >&2
      exit 1
      ;;
  esac
done

# -------------------------------
# VALIDATION (ROBUST)
# -------------------------------
[[ -z "$MODULE" ]] && { echo "Error: --module required" >&2; exit 1; }
[[ -z "$INPUT" ]] && { echo "Error: --input required" >&2; exit 1; }
[[ ! -f "$INPUT" ]] && { echo "Error: Input file '$INPUT' not found" >&2; exit 1; }
[[ ! -r "$INPUT" ]] && { echo "Error: Cannot read '$INPUT'" >&2; exit 1; }

# Check file size for memory efficiency
FILE_SIZE=$(stat -f%z "$INPUT" 2>/dev/null || stat -c%s "$INPUT")
[[ $FILE_SIZE -gt 1000000000 ]] && echo "Warning: Large file detected (${FILE_SIZE} bytes)"

# -------------------------------
# INFO
# -------------------------------
echo "[INFO] Module     : $MODULE"
echo "[INFO] Input      : $INPUT (${FILE_SIZE} bytes)"
echo "[INFO] Domain     : ${DOMAIN:-none}"
echo "[INFO] Pattern    : ${PATTERN:-none}"
echo "--------------------------------------"

# -------------------------------
# DISPATCHER (MEMORY EFFICIENT)
# -------------------------------
case $MODULE in
  seq-analysis)
    bash "$BASE_DIR/../modules/seq-analysis/run.sh" "$INPUT"
    ;;
  motif)
    bash "$BASE_DIR/../modules/motif/run.sh" "$INPUT" "$PATTERN"
    ;;
  translation)
    bash "$BASE_DIR/../modules/translation/run.sh" "$INPUT"
    ;;
  analysis)
    bash "$BASE_DIR/../modules/analysis/run.sh" "$INPUT" "$DOMAIN"
    ;;
  orf)
    bash "$BASE_DIR/../modules/ORF/run.sh" "$INPUT"
    ;;
  mutation)
    bash "$BASE_DIR/../modules/mutation/run.sh" "$INPUT"
    ;;
  assembly)
    bash "$BASE_DIR/../modules/assembly/run.sh" "$INPUT"
    ;;
esac
echo "[✔] GENEXIS COMPLETED SUCCESSFULLY"
